# Copy to .env and edit. Never commit the real .env.

# Database password used by the db and app containers.
POSTGRES_PASSWORD=change-me

# Keys the hashes of login codes and IP addresses. 32+ random characters, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-not-secret

# true: login codes are shown on screen and demo accounts are listed. Set false for a pilot.
DEMO_MODE=true
# true: an empty database is filled with demo accounts and sample rides.
SEED_DEMO_DATA=true
# true: for a public demo, wipe everything and load fresh sample rides once a day.
DEMO_DAILY_RESET=false
# true when the site is served over HTTPS.
COOKIE_SECURE=false

# Data retention, in days.
RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
SMS_RETENTION_DAYS=7

# Where the app listens on the host. Behind the Caddy proxy use APP_BIND=127.0.0.1.
APP_BIND=0.0.0.0
APP_PORT=8000
# Behind the Caddy proxy set * so the app sees each visitor's address (used for rate limits).
FORWARDED_ALLOW_IPS=127.0.0.1
# Public name for HTTPS (docker compose --profile https up -d).
DOMAIN=localhost
